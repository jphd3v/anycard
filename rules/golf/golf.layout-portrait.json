      "pileOrientation": "horizontal"
    },
    {
      "id": "actions",
      "cell": { "row": 2, "col": 1 },
      "piles": [],
      "widget": "actions"
    },
    {
      "id": "p1-hand",
      "label": "Player 1",
      "showLabel": true,
      "handForPlayerId": "P1",
