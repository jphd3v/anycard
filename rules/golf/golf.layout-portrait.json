      "piles": [
        "P1-far-left",
        "P1-far-right",
        "P1-near-left",
        "P1-near-right",
        "P1-draw"
      ],
      "subgrid": {
        "rows": 2,
        "cols": 3,
        "gap": "12px"
      },
      "pileGrid": {
        "P1-draw": { "row": 0, "col": 0, "rowspan": 2 },
        "P1-far-left": { "row": 0, "col": 1 },
        "P1-far-right": { "row": 0, "col": 2 },
        "P1-near-left": { "row": 1, "col": 1 },
        "P1-near-right": { "row": 1, "col": 2 }
